# ---------------------------------------------------------------------------
# Spin & Win — environment variables
# Copy this file to apps/web/.env.local and fill in the values.
# NEVER commit real values. Only this example file is tracked by git.
# ---------------------------------------------------------------------------

# --- Supabase (Dashboard → Project Settings → API / API Keys) ---------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY — never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------------
# Public base URL of this app (used in emails, QR codes, embed links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random secret (32+ chars) used to salt IP/device hashes for fraud signals.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINGERPRINT_SALT=

# Random secret (32+ chars) protecting internal cron endpoints (outbox sweeper, analytics refresh)
CRON_SECRET=

# Space-separated list of origins allowed to frame /embed (CSP frame-ancestors).
# The native WebView loads /embed top-level, so this is only needed for web-based hosts.
EMBED_FRAME_ANCESTORS='self'

# --- Loyalty adapter -------------------------------------------------------
# "mock" = built-in mock Suntec+ loyalty system (mock_suntec schema)
# "http" = real Suntec+ Loyalty API (configure below)
LOYALTY_ADAPTER=mock
SUNTEC_API_BASE_URL=
SUNTEC_API_KEY=
SUNTEC_API_TIMEOUT_MS=4000

# --- Integration tests (optional; use a SEPARATE test Supabase project) ------
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
