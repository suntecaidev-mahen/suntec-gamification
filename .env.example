# ---------------------------------------------------------------------------
# Spin & Win — environment variables
# Copy this file to apps/web/.env.local and fill in the values.
# NEVER commit real values. Only this example file is tracked by git.
# ---------------------------------------------------------------------------

# --- Supabase (Dashboard → Project Settings → API / API Keys) ---------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY — never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------------
# Public base URL of this app (used in emails, QR codes and app sign-in links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Which environment this is: local | uat | production
# local/uat show a small LOCAL/UAT tag in the admin menu and enable Admin → In-app test links.
# Customers see no test banner: the environment is told apart by its web address.
NEXT_PUBLIC_APP_ENV=local

# Deep link to the Suntec+ app sign-up screen, from the Suntec+ app team. {code} = guest claim code.
# Example: suntecplus://signup?claim={code}   Leave empty: "Join Suntec+" opens the App Store / Google Play.
NEXT_PUBLIC_SUNTEC_APP_SIGNUP_LINK=

# Random secret (32+ chars) used to salt IP/device hashes for fraud signals.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINGERPRINT_SALT=

# Random secret (32+ chars) for the scheduler calling POST /api/v1/jobs/tick (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Space-separated list of origins allowed to frame /play (CSP frame-ancestors).
# The native WebView loads /play top-level, so this is only needed for web-based hosts.
EMBED_FRAME_ANCESTORS='self'

# --- Loyalty adapter -------------------------------------------------------
# "mock"      = built-in mock Capillary loyalty + voucher system (mock_capillary schema, DEV/SIT)
# "capillary" = real Suntec+ / Capillary REST API (configure below; UAT/PROD)
LOYALTY_ADAPTER=mock
SUNTEC_API_BASE_URL=
SUNTEC_API_KEY=
SUNTEC_API_TIMEOUT_MS=4000

# --- Integration tests (optional; use a SEPARATE test Supabase project) ------
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
