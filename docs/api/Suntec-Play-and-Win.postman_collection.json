{
  "info": {
    "name": "Suntec+ Play & Win API (v1)",
    "description": "Integration and customer API for Suntec+ Play & Win.\n\n1. Import this collection and the environment file.\n2. In the environment set api_key (Admin → Administration → API clients → create a key with the scopes you need).\n3. Run folder 2 first (guest), then folder 1.\n\nEvery error has the form {\"error\":{\"code\",\"message\",\"details\",\"request_id\"}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Integration API (Suntec+ / Capillary → Play & Win)",
      "description": "Server-to-server endpoints called by the Suntec+ backend or Capillary. Authenticate with the X-API-Key header. Never call these from the mobile app itself.",
      "item": [
        {
          "name": "1.1 Create in-app session (open Play & Win)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('has single-use url', () => pm.expect(r.url).to.include('/api/v1/auth/exchange?code='));",
                  "pm.environment.set('handoff_url', r.url);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text",
                "description": "Integration API key from Admin → Administration → API clients"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member_id\": \"{{member_id}}\",\n  \"profile\": {\n    \"first_name\": \"Test\",\n    \"tier\": \"Gold\",\n    \"email\": \"test.member@example.com\"\n  },\n  \"entry\": \"home\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/integrations/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integrations",
                "sessions"
              ]
            },
            "description": "Scope sessions:write. Returns a single-use URL (valid 60 s). The app opens it in its WebView; the member is signed in automatically. Open {{handoff_url}} in a browser within 60 s to try it."
          }
        },
        {
          "name": "1.2 Create session — open straight into a game",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text",
                "description": "Integration API key from Admin → Administration → API clients"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member_id\": \"{{member_id}}\",\n  \"entry\": \"spin\",\n  \"game_id\": \"{{game_spin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/integrations/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integrations",
                "sessions"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "1.3 Send one event (purchase / transaction)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "pm.test('one result', () => pm.expect(pm.response.json().results.length).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text",
                "description": "Integration API key from Admin → Administration → API clients"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"transaction\",\n  \"external_id\": \"TXN-{{$timestamp}}\",\n  \"member_id\": \"{{member_id}}\",\n  \"occurred_at\": \"2026-11-28T12:30:00+08:00\",\n  \"payload\": {\n    \"amount_cents\": 5600,\n    \"merchant_code\": \"URBAN-THREADS\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/integrations/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integrations",
                "events"
              ]
            },
            "description": "Scope events:write. Types: transaction, mall_visit, voucher_redeemed, campaign_participation, activity. Idempotent on external_id: re-sending the same external_id returns duplicate=true and is not counted twice."
          }
        },
        {
          "name": "1.4 Send a batch of events",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text",
                "description": "Integration API key from Admin → Administration → API clients"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"type\": \"mall_visit\",\n      \"external_id\": \"VISIT-{{$timestamp}}\",\n      \"member_id\": \"{{member_id}}\",\n      \"payload\": {}\n    },\n    {\n      \"type\": \"voucher_redeemed\",\n      \"external_id\": \"VR-{{$timestamp}}\",\n      \"member_id\": \"{{member_id}}\",\n      \"payload\": {\n        \"voucher_code\": \"ABC123\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/integrations/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integrations",
                "events"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "1.5 Same event again (idempotency check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "pm.test('second send is duplicate', () => { /* run twice: 2nd response has duplicate=true */ pm.expect(pm.response.json().results[0]).to.have.property('duplicate'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text",
                "description": "Integration API key from Admin → Administration → API clients"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"mall_visit\",\n  \"external_id\": \"VISIT-FIXED-0001\",\n  \"member_id\": \"{{member_id}}\",\n  \"payload\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/integrations/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integrations",
                "events"
              ]
            },
            "description": "Send this twice. The second response shows \"duplicate\": true."
          }
        },
        {
          "name": "1.6 Grant bonus plays",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('attempts returned', () => pm.expect(pm.response.json().attempts).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text",
                "description": "Integration API key from Admin → Administration → API clients"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"game_id\": \"{{game_spin}}\",\n  \"count\": 1,\n  \"reason\": \"Spend $50 promotion\",\n  \"external_id\": \"GRANT-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/integrations/members/{{member_id}}/attempts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integrations",
                "members",
                "{{member_id}}",
                "attempts"
              ]
            },
            "description": "Scope attempts:write. count 1–20. Idempotent on external_id."
          }
        },
        {
          "name": "1.7 Member Play & Win summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text",
                "description": "Integration API key from Admin → Administration → API clients"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integrations/members/{{member_id}}/summary",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integrations",
                "members",
                "{{member_id}}",
                "summary"
              ]
            },
            "description": "Scope members:read. 404 NOT_FOUND if the member has never used Play & Win (run 1.1 first)."
          }
        },
        {
          "name": "1.8 Claim guest winnings for a new member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('claim result', () => pm.expect(pm.response.json()).to.have.property('claimed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text",
                "description": "Integration API key from Admin → Administration → API clients"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{claim_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/integrations/members/{{member_id}}/claims",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integrations",
                "members",
                "{{member_id}}",
                "claims"
              ]
            },
            "description": "Scope claims:write. Call after a guest signs up for Suntec+ with their claim code (run 2.2 first to get one). Errors: 404 INVALID_CLAIM, 409 CLAIM_USED, 410 CLAIM_EXPIRED."
          }
        }
      ]
    },
    {
      "name": "2. Customer API (guest flow — what the Play & Win screens call)",
      "description": "Run in order. 2.2 sets a guest cookie that Postman keeps for the following requests (Settings → cookies must be enabled).",
      "item": [
        {
          "name": "2.1 Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health?db=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ],
              "query": [
                {
                  "key": "db",
                  "value": "1"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "2.2 Start guest play",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('claim_code', pm.response.json().claim_code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/guest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "guest"
              ]
            },
            "description": "Returns 201 for a new guest (200 if the cookie already exists — the test will then show 200). Saves claim_code."
          }
        },
        {
          "name": "2.3 Home screen data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/home",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "home"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "2.4 Game details (Spin & Win)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/games/{{game_spin}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games",
                "{{game_spin}}"
              ]
            },
            "description": "Wheel segments and availability. Odds are never returned."
          }
        },
        {
          "name": "2.5 Play Spin & Win",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.environment.set('session_id', r.id);",
                  "pm.test('has outcome', () => pm.expect(r.outcome).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text",
                "description": "New UUID per action; re-send the same value to test idempotency"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/games/{{game_spin}}/play",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games",
                "{{game_spin}}",
                "play"
              ]
            },
            "description": "Outcome decided on the server. Guests: reward status \"held\" for 30 days."
          }
        },
        {
          "name": "2.6 Play Scratch & Win",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text",
                "description": "New UUID per action; re-send the same value to test idempotency"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/games/{{game_scratch}}/play",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games",
                "{{game_scratch}}",
                "play"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "2.7 Start Quiz & Win",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.environment.set('quiz_session_id', r.id);",
                  "const a = (r.questions || []).map(q => ({ question_id: q.id, option_id: (q.options && q.options[0]) ? q.options[0].id : null }));",
                  "pm.environment.set('quiz_answers', JSON.stringify(a));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text",
                "description": "New UUID per action; re-send the same value to test idempotency"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/games/{{game_quiz}}/play",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games",
                "{{game_quiz}}",
                "play"
              ]
            },
            "description": "Returns the questions without answers. The test script prepares answers (first option of each) for 2.8."
          }
        },
        {
          "name": "2.8 Submit quiz answers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"answers\": {{quiz_answers}} }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/sessions/{{quiz_session_id}}/answers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessions",
                "{{quiz_session_id}}",
                "answers"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "2.9 Get a play session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sessions/{{session_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessions",
                "{{session_id}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "2.10 Daily check-in status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/checkin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "checkin"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "2.11 Daily check-in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/checkin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "checkin"
              ]
            },
            "description": "One check-in per day; a second call the same day does not add points again."
          }
        },
        {
          "name": "2.12 Missions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/missions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "missions"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "2.13 My rewards",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/me/rewards",
              "host": [
                "{{base_url}}"
